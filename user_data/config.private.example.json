{
    "__comment__": "Copy this file to config.private.json (gitignored) and change the secrets. It is loaded IN ADDITION to config.json via `--config` and deep-merges on top. It enables the FreqUI web dashboard and switches to market orders (instant fills in dry-run).",
    "force_entry_enable": true,
    "exchange": {
        "enable_ws": false
    },
    "entry_pricing": {
        "price_side": "other"
    },
    "exit_pricing": {
        "price_side": "other"
    },
    "order_types": {
        "entry": "market",
        "exit": "market",
        "emergency_exit": "market",
        "force_entry": "market",
        "force_exit": "market",
        "stoploss": "market",
        "stoploss_on_exchange": false
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "127.0.0.1",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "CHANGE_ME_to_a_random_string_of_at_least_32_characters",
        "ws_token": "CHANGE_ME_to_a_random_token",
        "CORS_origins": [],
        "username": "CHANGE_ME_username",
        "password": "CHANGE_ME_password"
    }
}
